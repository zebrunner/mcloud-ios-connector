+// A device listed on USB and on Wi-Fi (the usbmuxd of macOS) tunnels over USB
+// only: its network entry is not attempted, whatever the order of the list.
+func TestUpdateTunnelsPrefersUSBOverNetwork(t *testing.T) {
+	for _, entries := range [][]ios.DeviceEntry{
+		{devEntry("dual-1", "Network"), devEntry("dual-1", "USB")},
+		{devEntry("dual-1", "USB"), devEntry("dual-1", "Network")},
+	} {
+		tm := leakTestManager(entries...)
+		if err := tm.UpdateTunnels(context.Background()); err != nil {
+			t.Fatalf("UpdateTunnels: %v", err)
+		}
+		got, ok := tm.failedDevices["dual-1"]
+		if !ok || got.failCount != 1 {
+			t.Fatalf("only the USB entry should be attempted (one failure), got ok=%v entry=%+v order=%s",
+				ok, got, entries[0].Properties.ConnectionType)
+		}
 	}
 }
 
